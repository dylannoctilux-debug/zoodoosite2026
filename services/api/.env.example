# API only. Prefer mounted encrypted Docker secrets (_FILE) in production.
PORT=4000
UPLOAD_DIR=/data/uploads
API_SERVICE_TOKEN_FILE=/run/secrets/api_service_token
MONGODB_URI_FILE=/run/secrets/mongodb_uri
EMAIL_SMTP_HOST_FILE=/run/secrets/smtp_host
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER_FILE=/run/secrets/smtp_user
EMAIL_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
EMAIL_FROM_FILE=/run/secrets/email_from
OWNER_EMAIL_FILE=/run/secrets/owner_email
