    "file-type": "^21.0.0",
    "zod": "^3.25.0",
    "dayjs": "^1.11.13",
    "tsx": "^4.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2",
    "@types/react": "^19.0.0",
    "prisma": "6.19.3",
    "@types/react-dom": "^19.0.0"
  }
}
